# Скопируйте этот файл в .env и подставьте реальные значения.
# .env в git не коммитится (см. .gitignore).

# Токен T-Invest API, выпущенный в личном кабинете Т-Инвестиций
# (Настройки -> токены; см. 2.2 аналитики). Формат: t.xxxxxxxx...
TINKOFF_TOKEN=t.your-tinkoff-token-here

# Произвольный секрет для доступа к REST API коллектора (Authorization: Bearer <ключ>).
ADMIN_API_KEY=your-admin-api-key-here
